{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "allowJs": true,
    "isolatedModules": true,
    "incremental": true,
    "types": ["bun-types", "react", "react-dom"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [".next/types/**/*.ts", "next-env.d.ts", "src", ".next-e2e/types/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
