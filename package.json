{
  "name": "gatecontrol",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable control plane for orchestrating AI coding agents in parallel under human review.",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "db:generate": "bun run --filter @gatecontrol/db db:generate",
    "db:migrate": "bun run --filter @gatecontrol/db db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
