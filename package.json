{
  "name": "gatecontrol",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable control plane for orchestrating AI coding agents in parallel under human review.",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "dev:web": "cd apps/web && bun --bun run dev",
    "dev:orchestrator": "bun --hot run apps/orchestrator/src/main.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "db:generate": "bun run --filter @gatecontrol/db db:generate",
    "db:migrate": "bun run --filter @gatecontrol/db db:migrate",
    "db:seed": "bun run --filter @gatecontrol/db db:seed",
    "openapi:gen": "bun run --filter @gatecontrol/web openapi:gen",
    "openapi:check": "bun run --filter @gatecontrol/web openapi:check",
    "e2e": "playwright test",
    "e2e:critical": "playwright test --grep @critical",
    "audit": "bun run scripts/audit.ts",
    "secretscan": "gitleaks detect --source . --no-banner --redact",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run openapi:check && bun run audit",
    "flag": "bun run scripts/flag.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@playwright/test": "^1.62.1",
    "typescript": "^5.9.3"
  }
}
