{
  "name": "solow-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable control plane for orchestrating AI coding agents in parallel under human review.",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "dev:web": "cd apps/web && bun --bun run dev",
    "dev:orchestrator": "bun --hot run apps/orchestrator/src/main.ts",
    "start": "sh scripts/start.sh",
    "build:cli": "bun run --filter '@satcomx00-x00/solow' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test && bun test scripts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "db:generate": "bun run --filter @solow/db db:generate",
    "db:migrate": "bun run --filter @solow/db db:migrate",
    "db:bootstrap": "bun run --filter @solow/db db:bootstrap",
    "openapi:gen": "bun run --filter @solow/web openapi:gen",
    "openapi:check": "bun run --filter @solow/web openapi:check",
    "smoke:docker": "sh scripts/smoke-docker-executor.sh",
    "e2e": "playwright test",
    "e2e:critical": "playwright test --grep @critical",
    "audit": "bun run scripts/audit.ts",
    "audit:executor-boundary": "bun run scripts/audit-executor-boundary.ts",
    "secretscan": "gitleaks detect --source . --no-banner --redact",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run openapi:check && bun run audit && bun run audit:executor-boundary",
    "flag": "bun run scripts/flag.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.62.1",
    "inngest-cli": "^1.44.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "bun",
    "inngest-cli"
  ],
  "overrides": {
    "postcss": "^8.5.27",
    "h3": "^1.15.9",
    "sharp": "^0.35.4",
    "qs": "^6.16.0",
    "adm-zip": "^0.6.0",
    "esbuild": "^0.25.12"
  }
}
